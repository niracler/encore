{
  "name": "@niracler/encore",
  "version": "0.4.1",
  "description": "A curtain call for your AI agent runs. Replay Codex, Claude Code, Claude.ai, WorkBuddy, and Antigravity sessions as an interactive web stage with a live context-window inspector.",
  "type": "module",
  "types": "./src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niracler/encore.git"
  },
  "homepage": "https://encore.niracler.com",
  "bugs": {
    "url": "https://github.com/niracler/encore/issues"
  },
  "bin": {
    "encore": "bin/encore.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./player.js": "./player/encore-player.js",
    "./player.css": "./player/encore-player.css",
    "./session.schema.json": "./schema/session.schema.json"
  },
  "files": [
    "bin",
    "src",
    "player/encore-player.js",
    "player/encore-player.css",
    "schema",
    "skills",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build:player": "node -e \"import('./src/player-assets.mjs').then(m => m.buildStandalonePlayerJs())\"",
    "build:site": "node scripts/build-site.mjs",
    "prepare": "node -e \"import('./src/player-assets.mjs').then(m => m.buildStandalonePlayerJs())\"",
    "prepack": "node -e \"import('./src/player-assets.mjs').then(m => m.buildStandalonePlayerJs())\"",
    "pretest": "node -e \"import('./src/player-assets.mjs').then(m => m.buildStandalonePlayerJs())\"",
    "prepublishOnly": "pnpm test",
    "release": "pnpm publish && git push origin main --follow-tags && gh release create \"v$(node -p \"require('./package.json').version\")\" --generate-notes",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "ai",
    "agent",
    "replay",
    "session-player",
    "codex",
    "claude-code",
    "workbuddy",
    "context-engineering",
    "asciinema"
  ],
  "author": "niracler",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "dependencies": {
    "@hyzyla/pdfium": "2.1.13",
    "node-xlsx": "0.25.0",
    "protobufjs": "8.8.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1"
  }
}
