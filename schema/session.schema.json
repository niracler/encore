{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://encore.niracler.com/schema/session.schema.json",
  "title": "Encore Session Replay",
  "description": "Self-contained intermediate representation (session.json) for AI agent session replays in Encore.",
  "type": "object",
  "required": ["tool", "title", "items"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional JSON Schema reference."
    },
    "tool": {
      "type": "string",
      "enum": ["codex", "claude-code", "claude-ai", "workbuddy", "antigravity", "antigravity-app", "antigravity-cli"],
      "description": "Source AI agent environment identifier."
    },
    "model": {
      "type": "string",
      "description": "Primary LLM model identifier used during the session."
    },
    "lang": {
      "type": "string",
      "enum": ["zh", "en"],
      "description": "Default UI language for the player."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Session title displayed in the header and browser tab."
    },
    "description": {
      "type": "string",
      "description": "Opening story intro displayed on the empty stage before playback begins."
    },
    "started": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of the first item in the session."
    },
    "ended": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of the last item in the session."
    },
    "tokens": {
      "type": "integer",
      "minimum": 0,
      "description": "Peak or total token count recorded in the session."
    },
    "contextWindow": {
      "type": "integer",
      "minimum": 1,
      "description": "Context window token capacity (e.g. 200000 or 1000000)."
    },
    "initialContext": {
      "type": "object",
      "description": "Initial mounted context records captured from the session preamble.",
      "properties": {
        "sys": {
          "type": "array",
          "items": { "$ref": "#/$defs/contextRecord" }
        },
        "schema": {
          "type": "array",
          "items": { "$ref": "#/$defs/contextRecord" }
        },
        "mem": {
          "type": "array",
          "items": { "$ref": "#/$defs/contextRecord" }
        },
        "skill": {
          "type": "array",
          "items": { "$ref": "#/$defs/contextRecord" }
        }
      },
      "additionalProperties": false
    },
    "frames": {
      "type": "array",
      "description": "Curated visual milestone frames (.webp) extracted or referenced during the session.",
      "items": { "$ref": "#/$defs/sessionFrame" }
    },
    "audioClips": {
      "type": "array",
      "description": "Optional audio clips generated during the session.",
      "items": { "$ref": "#/$defs/audioClip" }
    },
    "deliverables": {
      "type": "array",
      "description": "Final deliverables presented at the end of the replay.",
      "items": { "$ref": "#/$defs/deliverable" }
    },
    "items": {
      "type": "array",
      "description": "Ordered sequence of normalized conversation and tool events.",
      "items": { "$ref": "#/$defs/sessionItem" }
    }
  },
  "$defs": {
    "contextRecord": {
      "type": "object",
      "required": ["id", "title", "payload"],
      "properties": {
        "id": { "type": "string" },
        "tag": { "type": "string" },
        "title": { "type": "string" },
        "meta": { "type": "string" },
        "tokEst": { "type": "integer", "minimum": 0 },
        "stepIndex": { "type": "integer" },
        "payload": { "type": "string" },
        "images": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "sessionFrame": {
      "type": "object",
      "required": ["img"],
      "properties": {
        "time": { "type": "string" },
        "img": { "type": "string" },
        "who": { "type": "string", "enum": ["you", "ai"] },
        "label": { "type": "string" },
        "w": { "type": "integer", "minimum": 1 },
        "h": { "type": "integer", "minimum": 1 }
      }
    },
    "audioClip": {
      "type": "object",
      "required": ["src"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "src": { "type": "string" },
        "time": { "type": "string" }
      }
    },
    "deliverable": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string" },
        "href": { "type": "string" },
        "meta": { "type": "string" },
        "cover": { "type": "string" },
        "previewSheet": { "type": "string" },
        "source": {
          "type": "object", "required": ["path"],
          "description": "External reference consumed at export. An optional SHA-256 must come from the session at handoff.",
          "properties": { "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" } }
        },
        "availability": { "enum": ["verified", "export-copy", "missing"] },
        "sessionSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "unavailableReason": { "enum": ["outside-root", "unreadable"] },
        "previewColumns": { "type": "array", "items": { "type": "string" } },
        "revision": {
          "type": "object",
          "description": "Earlier local file and the corresponding line or cell to compare in both versions.",
          "required": ["href", "label"],
          "oneOf": [{ "required": ["page", "linePrefix"] }, { "required": ["sheet", "cell"] }],
          "properties": {
            "href": { "type": "string" }, "label": { "type": "string" },
            "page": { "type": "integer", "minimum": 1 }, "linePrefix": { "type": "string", "minLength": 1 },
            "sheet": { "type": "string", "minLength": 1 }, "cell": { "type": "string", "pattern": "^[a-zA-Z]+[1-9][0-9]*$" }
          }
        },
        "preview": {
          "properties": {
            "change": {
              "type": "object", "required": ["before", "after"],
              "properties": { "before": { "type": "string" }, "after": { "type": "string" } }
            }
          },
          "oneOf": [
            {
              "type": "object", "required": ["type", "pages"],
              "properties": {
                "type": { "const": "pdf" },
                "pages": { "type": "array", "minItems": 1, "items": {
                  "type": "object", "required": ["src", "width", "height"],
                  "properties": { "src": { "type": "string" }, "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } }
                } }
              }
            },
            {
              "type": "object", "required": ["type", "src", "sheet", "count", "rows"],
              "properties": {
                "type": { "const": "xlsx" }, "src": { "type": "string" }, "sheet": { "type": "string" },
                "count": { "type": "integer", "minimum": 1 },
                "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
              }
            }
          ]
        },
        "portrait": {
          "description": "Portrait cut of the same video, sharing the landscape cut's timeline.",
          "type": "object",
          "required": ["href"],
          "properties": {
            "href": { "type": "string" },
            "cover": { "type": "string" }
          }
        }
      }
    },
    "sessionItem": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "deliverables": {
          "type": "array", "description": "Files handed over at this event.",
          "items": { "$ref": "#/$defs/deliverable" }
        },
        "type": {
          "type": "string",
          "enum": ["user", "assistant", "reasoning", "tool", "compact"]
        },
        "text": { "type": "string" },
        "time": { "type": "string" },
        "done": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "summary": { "type": "string" },
        "input": { "type": "string" },
        "output": { "type": "string" },
        "file": { "type": "string" },
        "files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "skill": { "type": "string" },
        "agent": { "type": "string" },
        "question": { "type": "boolean" },
        "answer": { "type": "boolean" },
        "contextTokens": { "type": "integer", "minimum": 0 },
        "images": {
          "type": "array",
          "items": { "type": "string" }
        },
        "omittedImages": { "type": "integer", "minimum": 0 },
        "stats": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "seq": { "type": "integer", "minimum": 1 },
        "trigger": { "type": "string" },
        "preTokens": { "type": "integer", "minimum": 0 },
        "postTokens": { "type": "integer", "minimum": 0 },
        "droppedTokens": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
